rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Trips rules (trips and hometown logs)
    match /trips/{tripId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Timeline chapters rules
    match /timeline_chapters/{chapterId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Visited places rules
    match /visited_places/{placeId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Wishlist rules
    match /wishlist/{wishlistId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
