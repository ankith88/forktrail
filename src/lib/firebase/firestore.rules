rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rules
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Trips rules
    match /trips/{tripId} {
      allow read: if resource.data.visibility == 'public' || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Timeline chapters rules
    match /timeline_chapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Visited places rules
    match /visited_places/{placeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Wishlist rules
    match /wishlist/{wishlistId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
